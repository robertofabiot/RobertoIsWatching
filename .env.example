# ==============================================================================
# Roberto's Watching — Configuration Template
# ==============================================================================
# Copie este archivo a `.env` y complete los valores requeridos.
# NUNCA guarde secretos ni tokens reales en el control de versiones.

# Token HTTP del bot de Telegram emitido por @BotFather (requerido)
# Formato: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ID numérico de Telegram del administrador (@userinfobot) (requerido)
# Ejemplo: 1125347763
ADMIN_CHAT_ID=1125347763

# URL de conexión SQLite (requerido)
# Nota: mode=rwc creará la base de datos automáticamente si no existe.
DATABASE_URL=sqlite://robertos_watching.db?mode=rwc

# Límite máximo de alumnos registrados por defecto (opcional, default: 300)
MAX_USERS_DEFAULT=300

# Zona horaria del bot según IANA Time Zone Database (requerido)
# Usado para resúmenes matutinos y cálculo de plazos locales (sin DST)
BOT_TZ=America/Managua

# Nivel de log para tracing-subscriber (opcional)
# Ejemplo para desarrollo: info,robertos_watching_bot=debug
# Ejemplo para producción: info,robertos_watching_bot=info
RUST_LOG=info,robertos_watching_bot=debug

# Intervalo de escaneo periódico en minutos para el ScannerWorker (opcional, default: 30, rango: 1-1440)
SCAN_INTERVAL_MIN=30

