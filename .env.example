# ==============================================================================
# Roberto's Watching — Configuration Template (.env.example)
# ==============================================================================
# Copie este archivo a `.env` en el directorio de trabajo del bot:
#   cp .env.example .env && chmod 600 .env
#
# REGLAS DE SEGURIDAD:
# - Asigne permisos estrictos 0600 (`chmod 600 .env`) al archivo generado.
# - El archivo debe pertenecer al usuario de ejecución del servicio (`chown robertos:robertos .env`).
# - NUNCA guarde credenciales, tokens ni secretos en el control de versiones (git).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Credentials
# ------------------------------------------------------------------------------
# Token de acceso HTTP emitido por @BotFather al crear el bot (requerido).
# Formato estricto: <id_numerico>:<secreto_alfanumerico>
# Ejemplo: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ID numérico de Telegram del administrador del sistema (requerido).
# Obtenible mediante bots como @userinfobot o enviando un mensaje al bot.
# Habilita los comandos protegidos: /admin_stats, /toggle_registro, /set_max_users.
ADMIN_CHAT_ID=1125347763

# ------------------------------------------------------------------------------
# 2. Base de Datos SQLite (sqlx)
# ------------------------------------------------------------------------------
# URL de conexión SQLite (requerido).
# En producción bajo systemd (/opt/robertos-watching), use ruta absoluta con triple barra:
#   sqlite:///opt/robertos-watching/robertos_watching.db?mode=rwc
# Para desarrollo local puede usarse una ruta relativa:
#   sqlite://robertos_watching.db?mode=rwc
# Nota: ?mode=rwc crea el archivo automáticamente si no existe y sqlx ejecuta
# las migraciones pendientes en modo WAL de forma automática al iniciar.
DATABASE_URL=sqlite:///opt/robertos-watching/robertos_watching.db?mode=rwc

# ------------------------------------------------------------------------------
# 3. Control de Capacidad y Admisión
# ------------------------------------------------------------------------------
# Cupo máximo por defecto de estudiantes activos permitidos (opcional, default: 300).
# Se siembra en la base de datos al arrancar si no existe una configuración previa.
# Puede ajustarse dinámicamente en caliente mediante el comando /set_max_users.
MAX_USERS_DEFAULT=300

# ------------------------------------------------------------------------------
# 4. Zona Horaria y Planificación
# ------------------------------------------------------------------------------
# Identificador IANA de la zona horaria del bot (requerido).
# Utilizado para el cálculo y envío de resúmenes diarios programados,
# formateo de horas locales de entregas de tareas y comparaciones temporales.
# Ejemplo: America/Managua (UTC-6 sin cambio de hora estacional).
BOT_TZ=America/Managua

# ------------------------------------------------------------------------------
# 5. Escáner Periódico de Moodle
# ------------------------------------------------------------------------------
# Intervalo en minutos entre cada ciclo de escaneo en segundo plano (opcional, default: 30).
# Rango permitido: 1 a 1440 minutos (1 minuto a 24 horas).
# En producción se recomienda mantener entre 30 y 60 minutos para evitar sobrecarga en UAM Virtual.
SCAN_INTERVAL_MIN=30

# ------------------------------------------------------------------------------
# 6. Telemetría y Logging (tracing-subscriber / EnvFilter)
# ------------------------------------------------------------------------------
# Nivel de detalle de eventos y trazas del sistema (opcional).
# En producción se recomienda:
#   RUST_LOG=info
# Para desarrollo o diagnóstico temporal:
#   RUST_LOG=info,robertos_watching_bot=debug
RUST_LOG=info

# ------------------------------------------------------------------------------
# 7. Respaldo Online de Base de Datos SQLite (deploy/backup.sh)
# ------------------------------------------------------------------------------
# Días de retención para los respaldos en caliente de SQLite (opcional, default: 30).
# Los respaldos 'rw-*.db' con mayor antigüedad se purgan automáticamente tras cada snapshot.
# BACKUP_RETENTION_DAYS=30
