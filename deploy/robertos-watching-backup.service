[Unit]
Description=Roberto's Watching - SQLite Online Backup
After=network.target

[Service]
Type=oneshot
User=robertos
Group=robertos
WorkingDirectory=/opt/robertos-watching
ExecStart=/opt/robertos-watching/backup.sh
EnvironmentFile=-/opt/robertos-watching/.env
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/robertos-watching
