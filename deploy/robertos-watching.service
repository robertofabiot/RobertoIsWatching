[Unit]
Description=Roberto's Watching - Telegram Bot for UAM Virtual (Rust Multi-User)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robertos
Group=robertos
WorkingDirectory=/opt/robertos-watching
ExecStart=/opt/robertos-watching/robertos-watching-bot
EnvironmentFile=/opt/robertos-watching/.env
Restart=always
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/robertos-watching
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
